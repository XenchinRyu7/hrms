---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'EHMRS — Human Resource Management System',
  description = 'Enterprise Human Resource Management System',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark" data-color-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Inter & JetBrains Mono Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Anti-flicker Theme Hydration -->
    <script is:inline>
      (function() {
        const mode = localStorage.getItem('ethereal_theme_mode') || 'dark';
        const theme = localStorage.getItem('ethereal_color_theme') || 'default';
        if (mode === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        document.documentElement.setAttribute('data-color-theme', theme);
        if (theme && theme !== 'default') {
          let link = document.getElementById('ethereal-active-theme');
          if (!link) {
            link = document.createElement('link');
            link.id = 'ethereal-active-theme';
            link.rel = 'stylesheet';
            document.head.appendChild(link);
          }
          link.href = '/themes/' + theme + '.css';
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen selection:bg-primary/20 selection:text-primary transition-colors duration-150">
    <slot />
  </body>
</html>
