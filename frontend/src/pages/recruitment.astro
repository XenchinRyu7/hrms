---
import RootLayout from '../layouts/RootLayout.astro';
import { AuthProvider } from '../lib/auth-context';
import { HRMSAppShell } from '../components/layout/HRMSAppShell';
import { RecruitmentView } from '../components/views/RecruitmentView';
---

<RootLayout title="Recruitment & ATS Pipeline — Ethereal HRMS">
  <AuthProvider client:only="react">
    <HRMSAppShell client:only="react" activePath="/recruitment">
      <RecruitmentView client:only="react" />
    </HRMSAppShell>
  </AuthProvider>
</RootLayout>
