---
import RootLayout from '../layouts/RootLayout.astro';
import { AuthProvider } from '../lib/auth-context';
import { HRMSAppShell } from '../components/layout/HRMSAppShell';
import { AttendanceView } from '../components/views/AttendanceView';
---

<RootLayout title="Attendance & Timesheets — Ethereal HRMS">
  <AuthProvider client:only="react">
    <HRMSAppShell client:only="react" activePath="/attendance">
      <AttendanceView client:only="react" />
    </HRMSAppShell>
  </AuthProvider>
</RootLayout>
