---
import RootLayout from '../layouts/RootLayout.astro';
import { AuthProvider } from '../lib/auth-context';
import { HRMSAppShell } from '../components/layout/HRMSAppShell';
import { PayrollView } from '../components/views/PayrollView';
---

<RootLayout title="Payroll & Compensation — Ethereal HRMS">
  <AuthProvider client:only="react">
    <HRMSAppShell client:only="react" activePath="/payroll">
      <PayrollView client:only="react" />
    </HRMSAppShell>
  </AuthProvider>
</RootLayout>
