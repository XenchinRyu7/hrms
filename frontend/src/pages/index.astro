---
import RootLayout from '../layouts/RootLayout.astro';
import { AuthProvider } from '../lib/auth-context';
import { HRMSAppShell } from '../components/layout/HRMSAppShell';
import { DashboardView } from '../components/views/DashboardView';
---

<RootLayout title="Executive Console — Ethereal HRMS">
  <AuthProvider client:only="react">
    <HRMSAppShell client:only="react" activePath="/">
      <DashboardView client:only="react" />
    </HRMSAppShell>
  </AuthProvider>
</RootLayout>
